# Backend Environment Variables Template

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecofarm_dev"
DATABASE_POOL_SIZE=20

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ============================================
# OTP Configuration (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
OTP_EXPIRY=600

# ============================================
# Weather API (OpenWeather)
# ============================================
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ============================================
# Google Maps API
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# AI/ML Configuration
# ============================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# LangChain
LANGCHAIN_API_KEY=your_langchain_api_key

# Pest Detection Model
PEST_MODEL_PATH=./models/pest_detection_model.tflite
PEST_MODEL_VERSION=v1.0.0

# ============================================
# Firebase Configuration
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@appspot.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# ============================================
# AWS S3 Configuration (Optional)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ecofarm-uploads
AWS_S3_URL=https://ecofarm-uploads.s3.amazonaws.com

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@ecofarm.app

# ============================================
# Real-time data sources
# ============================================
AGMARKNET_API_URL=https://api.your-agmarknet-endpoint.example/market-prices
MARKET_UPDATE_HOURS=6
WEATHER_UPDATE_HOURS=1
WEATHER_LOCATIONS=[{"name":"Bengaluru","lat":12.9716,"lon":77.5946}]
GOVERNMENT_WEATHER_URL=https://data.gov.in/api/your-agri-weather-endpoint

# ============================================
# Firebase Cloud Messaging (FCM)
# ============================================
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ============================================
# AI Insight Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gpt-4
DEV_LOGIN_CONTACTS=demo@example.com,+919876543210

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=/var/log/ecofarm/app.log

# ============================================
# Feature Flags
# ============================================
ENABLE_PEST_DETECTION=true
ENABLE_CHATBOT=true
ENABLE_MARKET_ALERTS=true
ENABLE_IOT_INTEGRATION=false
ENABLE_SATELLITE_MONITORING=false

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Cache Configuration
# ============================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ============================================
# Monitoring & Analytics
# ============================================
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_api_key

# ============================================
# Third-party Services
# ============================================
SEGMENT_WRITE_KEY=your_segment_write_key
MIXPANEL_TOKEN=your_mixpanel_token
